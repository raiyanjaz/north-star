# Required: running Zetaris platform and credentials for your organization.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Replace 1 with the organization ID matching your API key.
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Required: native Nightshift Runtime with a working NVIDIA provider/model.
# Configure the NVIDIA provider key inside Nightshift; do not put it here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: TomTom Traffic + Routing access. Blank uses OSRM static estimates.
TOMTOM_API_KEY=
