{
  "name": "arc-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/test-dispatch-model.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write frontend tests/browser *.ts *.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/leaflet": "^1.9.21",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.25.0"
}
